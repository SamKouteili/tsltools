#LIA

/* Full spec: liveness + safety biconditional.
 * Grid: 4x4, Start: (0,0), Goal: (3,3)
 * Holes: (1,1), (3,1), (3,2)
 */

initially assume {
    eq x int0();
    eq y int0();
}

always guarantee {
    /* Stay in bounds */
    G ((gte x int0()) && (lte x int3()) && (gte y int0()) && (lte y int3()));

    /* Movement: one axis at a time */
    G ((([x <- x] || [x <- add x int1()] || [x <- sub x int1()]) && [y <- y]) || ([x <- x] && ([y <- y] || [y <- add y int1()] || [y <- sub y int1()])));

    /* Objective: reach goal AND safety biconditional (hole avoidance) */
    (F ((eq x int3()) && (eq y int3()))) && (G ((eq x int1() && eq y int1()) <-> ((eq x int3() && eq y int1()) || (eq x int3() && eq y int2()))));
}
